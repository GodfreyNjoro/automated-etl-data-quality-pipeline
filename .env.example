# Copy to .env and adjust. All variables are prefixed with ETL_.
# Secrets must never be committed; .env is git-ignored.

# Runtime
ETL_ENVIRONMENT=development
ETL_LOG_LEVEL=INFO
ETL_LOG_JSON=true

# Metadata database (pipeline history, quality metrics, lineage)
ETL_METADATA_DB_HOST=localhost
ETL_METADATA_DB_PORT=5432
ETL_METADATA_DB_NAME=etl_metadata
ETL_METADATA_DB_USER=etl
ETL_METADATA_DB_PASSWORD=etl

# Default target warehouse
ETL_WAREHOUSE_DB_HOST=localhost
ETL_WAREHOUSE_DB_PORT=5432
ETL_WAREHOUSE_DB_NAME=retail_warehouse
ETL_WAREHOUSE_DB_USER=etl
ETL_WAREHOUSE_DB_PASSWORD=etl

# Performance tuning
ETL_BATCH_SIZE=5000
ETL_MAX_RETRIES=3
ETL_RETRY_BACKOFF_SECONDS=2.0

# Email alerting (SMTP)
ETL_ALERT_EMAIL_ENABLED=false
ETL_SMTP_HOST=smtp.example.com
ETL_SMTP_PORT=587
ETL_SMTP_USER=
ETL_SMTP_PASSWORD=
ETL_ALERT_EMAIL_FROM=etl-alerts@example.com
ETL_ALERT_EMAIL_TO=ops@example.com

# Slack alerting
ETL_SLACK_WEBHOOK_URL=
ETL_ALERT_SUPPRESSION_MINUTES=30

# Source secrets referenced by config files via ${VAR}
POS_API_TOKEN=
CRM_API_KEY=
INVENTORY_DB_PASSWORD=
WAREHOUSE_DB_PASSWORD=etl
